---
/** Stacked coalition bars with 2px surface gaps and a majority tick. */
import { colorVar, type PartyKey } from '@/lib/parties';
import type { PartyResult } from '@/lib/queries';

interface Props {
  results: PartyResult[];
  combos: { label: string; parties: PartyKey[] }[];
}

const { results, combos } = Astro.props;
const seatOf = (k: PartyKey) => results.find((r) => r.key === k)?.seats ?? 0;
const total = results.reduce((a, r) => a + r.seats, 0);
const majority = Math.floor(total / 2) + 1;

const w = 520;
const rowH = 56;
const barH = 12;
const gap = 2;
const h = rowH * combos.length + 14;
const mx = (w * majority) / total;
---

<svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Mögliche Mehrheiten">
  {
    combos.map((c, i) => {
      const y = i * rowH;
      const sum = c.parties.reduce((a, k) => a + seatOf(k), 0);
      const ok = sum >= majority;
      let x = 0;
      const segs = c.parties.map((k) => {
        const seg = (w * seatOf(k)) / total;
        const el = { x, wSeg: Math.max(seg - gap, 0), k };
        x += seg;
        return el;
      });
      const rowTip = ok
        ? `${c.label}: ${sum} von ${total} Sitzen · ${sum === majority ? 'exakt die Mehrheit' : `${sum - majority} Sitze über der Mehrheitsgrenze`}`
        : `${c.label}: ${sum} von ${total} Sitzen · ${majority - sum} Sitze fehlen zur Mehrheit`;
      return (
        <g class="crow" data-tip={rowTip}>
          <text x="0" y={y + 14} class="t-lbl">
            {ok ? '✓' : '✕'} {c.label}
          </text>
          <text x={w} y={y + 14} text-anchor="end" class="t-val">
            {sum}
          </text>
          <rect x="0" y={y + 24} width={w} height={barH} rx="2" fill="var(--hairline)" />
          {segs.map((s) => (
            <g
              class="seg"
              role="img"
              aria-label={`${s.k}: ${seatOf(s.k)} ${seatOf(s.k) === 1 ? 'Sitz' : 'Sitze'}`}
              data-tip={`${s.k} · ${seatOf(s.k)} ${seatOf(s.k) === 1 ? 'Sitz' : 'Sitze'}`}
            >
              <rect
                class="seg-v"
                x={s.x.toFixed(1)}
                y={y + 24}
                width={s.wSeg.toFixed(1)}
                height={barH}
                rx="2"
                fill={colorVar(s.k)}
              />
              <rect
                class="seg-hit"
                x={s.x.toFixed(1)}
                y={y + 16}
                width={s.wSeg.toFixed(1)}
                height={barH + 16}
                fill="transparent"
              />
            </g>
          ))}
          <line x1={mx.toFixed(1)} y1={y + 20} x2={mx.toFixed(1)} y2={y + 40} stroke="var(--ink)" stroke-width="1.5" />
        </g>
      );
    })
  }
  <text x={mx.toFixed(1)} y={h - 2} text-anchor="middle" class="t-dim">
    Mehrheit ab {majority} Sitze
  </text>
</svg>

<style>
  svg {
    width: 100%;
    height: auto;
  }
  /* hover: the hovered party segment stays, siblings in the same row recede;
     the invisible .seg-hit rect widens the 12px bar to a usable hit target */
  .seg-v {
    transition: opacity 0.15s ease;
  }
  .crow:has(.seg:hover) .seg:not(:hover) .seg-v {
    opacity: 0.35;
  }
</style>
