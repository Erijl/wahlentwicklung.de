---
/** Dense result table: one row per area, party share columns. Also serves
 *  as the universal "raw data" view behind every chart toggle. */
import PartyTag from '@/components/PartyTag.astro';
import { fmtPct } from '@/lib/format';
import { CHART_ORDER, type PartyKey } from '@/lib/parties';
import type { ConstituencyTableRow } from '@/lib/queries';
import { constituencySlug } from '@/lib/slugs';

interface Props {
  rows: ConstituencyTableRow[];
  /** Party columns; default = the classic seven. */
  columns?: PartyKey[];
  linkYear?: number;
}

const {
  rows,
  columns = CHART_ORDER.filter((k) => !['FW', 'SSW', 'Übrige'].includes(k)),
  linkYear,
} = Astro.props;
const pctOf = (row: ConstituencyTableRow, k: PartyKey) =>
  row.results.find((r) => r.key === k)?.pct ?? 0;
---

<div class="tblwrap">
  <table>
    <thead>
      <tr>
        <th class="wk">Wahlkreis</th>
        <th>Beteiligung</th>
        {columns.map((k) => <th><PartyTag party={k} /></th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="wk">
              <a
                href={
                  linkYear
                    ? `/wahl/${linkYear}/wahlkreis/${constituencySlug(row.number, row.name)}`
                    : `/wahlkreis/${constituencySlug(row.number, row.name)}`
                }
              >
                {row.name}
              </a>
              <span>{row.stateName}</span>
            </td>
            <td>{fmtPct(row.turnout).replace(' %', '')}</td>
            {columns.map((k) => <td>{fmtPct(pctOf(row, k)).replace(' %', '')}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .tblwrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }
  th {
    font-size: 12px;
    color: var(--text-sec);
    text-align: right;
    font-weight: 600;
    padding: 8px 10px;
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
  }
  th.wk,
  td.wk {
    text-align: left;
    padding-left: 0;
  }
  td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: right;
    font-size: 13.5px;
  }
  td.wk a {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }
  td.wk span {
    font-size: 11.5px;
    color: var(--text-muted);
  }
</style>
