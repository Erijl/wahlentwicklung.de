---
/** Stat-tile contract: label · value · sub/delta (docs/03-design-system.md §5). */
interface Props {
  label: string;
  value: string;
  sub?: string;
}
const { label, value, sub } = Astro.props;
---

<div class="tile">
  <span class="tl">{label}</span>
  <span class="tv">{value}</span>
  {sub && <span class="td">{sub}</span>}
</div>

<style>
  .tile {
    background: var(--raised);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl {
    font-size: 12.5px;
    color: var(--text-sec);
  }
  .tv {
    font-size: 22px;
    font-weight: 700;
    font-family: var(--font-serif);
  }
  .td {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
