---
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/600.css';
import '@fontsource/fira-sans/700.css';
import '@fontsource/fira-sans-condensed/700.css';
import '@fontsource/noto-serif/400.css';
import '@fontsource/noto-serif/700.css';
import '@/styles/global.css';

interface Props {
  /** Page title without the site suffix. */
  title: string;
  description: string;
  /** Canonical path, e.g. "/wahl/2025". */
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site);
const fullTitle = `${title} | Wahlentwicklung.de`;

const nav = [
  { href: '/wahlen', label: 'Wahlen' },
  { href: '/parteien', label: 'Parteien' },
  { href: '/bundeslaender', label: 'Bundesländer' },
  { href: '/wahlkreise', label: 'Wahlkreise' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* theme before paint (no FOUC): stored preference wins, else system */}
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    {/* TODO(nav): placeholder chrome — user wants a different navigation
        concept; iterate in a dedicated design pass. */}
    <header class="site-head">
      <div class="inner">
        <a class="brand" href="/">
          Wahlentwicklung<span class="tld">.de</span>
        </a>
        <nav aria-label="Hauptnavigation">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <button id="theme-toggle" type="button" title="Helles/dunkles Design umschalten">
            ◐
          </button>
        </nav>
      </div>
      <div class="tric" aria-hidden="true"><i></i><i></i><i></i></div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    {/* hover layer: any element with data-tip gets a styled tooltip.
        Pages stay fully static — this is progressive enhancement. */}
    <div class="tip" id="global-tip" role="tooltip" hidden></div>
    <script>
      const tip = document.getElementById('global-tip')!;
      let current: Element | null = null;
      function move(e: PointerEvent) {
        const pad = 12;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + pad;
        let y = e.clientY + pad;
        if (x + r.width > innerWidth - 4) x = e.clientX - r.width - pad;
        if (y + r.height > innerHeight - 4) y = e.clientY - r.height - pad;
        tip.style.transform = `translate(${x}px, ${y}px)`;
      }
      document.addEventListener('pointerover', (e) => {
        const el = (e.target as Element).closest('[data-tip]');
        if (!el || el === current) return;
        current = el;
        tip.textContent = el.getAttribute('data-tip');
        tip.hidden = false;
        move(e as PointerEvent);
      });
      document.addEventListener('pointermove', (e) => {
        if (current) move(e as PointerEvent);
      });
      document.addEventListener('pointerout', (e) => {
        if (current && !current.contains((e as PointerEvent).relatedTarget as Node)) {
          current = null;
          tip.hidden = true;
        }
      });
    </script>

    <footer class="site-foot">
      <p>
        Datengrundlage: Bundeswahlleiterin, amtliche Endergebnisse 2005–2025 ·
        <a
          href="https://www.bundeswahlleiterin.de/bundestagswahlen.html"
          rel="noopener">Datensatz ↗</a
        > · <a href="/wahlen">Alle Wahlen</a> · <a href="/impressum">Impressum</a>
      </p>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme === 'dark';
        if (dark) delete root.dataset.theme;
        else root.dataset.theme = 'dark';
        localStorage.setItem('theme', dark ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style>
  .site-head .inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 16px 28px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--ink);
  }
  .brand:hover {
    text-decoration: none;
  }
  .tld {
    color: var(--text-muted);
    font-weight: 400;
  }
  nav {
    display: flex;
    gap: 20px;
    font-size: 14.5px;
  }
  nav a {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    font-weight: 700;
    color: var(--accent);
  }
  #theme-toggle {
    border: 1px solid var(--hairline);
    background: var(--raised);
    color: var(--text-sec);
    font-size: 14px;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
  }
  .tric {
    display: flex;
    height: 3px;
  }
  .tric i {
    flex: 1;
  }
  .tric i:nth-child(1) {
    background: var(--tric-schwarz);
  }
  .tric i:nth-child(2) {
    background: var(--tric-rot);
  }
  .tric i:nth-child(3) {
    background: var(--tric-gold);
  }
  .site-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px 40px;
  }
  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    pointer-events: none;
    background: var(--ink);
    color: var(--surface);
    font-size: 12.5px;
    line-height: 1.4;
    padding: 6px 9px;
    border-radius: 4px;
    max-width: 280px;
    white-space: pre-line;
  }
  .site-foot {
    border-top: 1px solid var(--hairline);
    color: var(--text-muted);
    font-size: 12.5px;
  }
  .site-foot p {
    max-width: 1120px;
    margin: 0 auto;
    padding: 20px 28px 40px;
  }
</style>
