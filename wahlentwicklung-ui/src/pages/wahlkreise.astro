---
/** Constituency grid list — 299 entries with client-side search island. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchFilter from '@/components/islands/SearchFilter.svelte';
import MiniBars from '@/components/charts/MiniBars.astro';
import {
  getElectionYears,
  getConstituencies,
  constituencyResults,
  constituencyVoteBase,
  constituencyYears,
} from '@/lib/queries';
import { hoverCard } from '@/lib/hovercard';
import { constituencySlug } from '@/lib/slugs';

const years = getElectionYears();
const constituencies = getConstituencies().map((c) => {
  const latest = constituencyYears(c.id).at(-1)!;
  const results = constituencyResults(latest, c.id);
  return {
    ...c,
    results,
    card: hoverCard({
      kicker: `${c.stateName} · Wahlkreis ${c.number}`,
      title: c.name,
      turnout: constituencyVoteBase(latest, c.id)?.turnout,
      year: latest,
      prevYear: years[years.indexOf(latest) - 1],
      results,
    }),
  };
});
---

<BaseLayout
  title="Alle 299 Wahlkreise"
  description="Alle 299 Bundestagswahlkreise mit Nummer, Bundesland und Detailseite: Ergebnisse und Entwicklung seit 2005."
  path="/wahlkreise"
>
  <section class="hero">
    <p class="kicker">Übersicht</p>
    <h1>Wahlkreise</h1>
    <p class="lede">
      Alle 299 Wahlkreise (Zuschnitt der aktuellen Wahlperiode) — mit Ergebnisentwicklung und den
      Resultaten jeder Bundestagswahl.
    </p>
  </section>

  <SearchFilter client:load target="wk-list" placeholder="Wahlkreis oder Bundesland suchen …" />

  <ul class="wklist" id="wk-list">
    {
      constituencies.map((c) => (
        <li data-search={`${c.number} ${c.name} ${c.stateName}`}>
          <a href={`/wahlkreis/${constituencySlug(c.number, c.name)}`}>
            <span class="num">{c.number}</span>
            <MiniBars results={c.results} card={c.card} />
            <span class="name">
              <strong>{c.name}</strong>
              <span>{c.stateName}</span>
            </span>
            <span class="go">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .hero {
    padding: 26px 0 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wklist {
    list-style: none;
    border-top: 1px solid var(--hairline);
    columns: 2;
    column-gap: 40px;
  }
  @media (max-width: 800px) {
    .wklist {
      columns: 1;
    }
  }
  .wklist li {
    break-inside: avoid;
    border-bottom: 1px solid var(--hairline);
  }
  .wklist a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 0;
    color: var(--ink);
  }
  .wklist a:hover {
    text-decoration: none;
    background: var(--raised);
  }
  .num {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    font-size: 12.5px;
    min-width: 30px;
  }
  .name {
    display: flex;
    flex-direction: column;
  }
  .name strong {
    font-size: 14px;
    font-weight: 600;
  }
  .name span {
    font-size: 11.5px;
    color: var(--text-muted);
  }
  .go {
    margin-left: auto;
    color: var(--text-muted);
  }
</style>
