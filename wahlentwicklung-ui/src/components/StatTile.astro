---
/** Stat-tile contract: label · value · sub/delta (docs/03-design-system.md §5).
 *  Optional `card` (lib/hovercard.ts statCard JSON) adds a rich hover card
 *  with the stat's context — hover-capable devices only, nothing is gated. */
interface Props {
  label: string;
  value: string;
  sub?: string;
  card?: string;
}
const { label, value, sub, card } = Astro.props;
---

<div class="tile" data-card={card}>
  <span class="tl">{label}</span>
  <span class="tv">{value}</span>
  {sub && <span class="td">{sub}</span>}
</div>

<style>
  .tile {
    background: var(--raised);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tile[data-card] {
    cursor: help;
  }
  @media (hover: hover) and (pointer: fine) {
    .tile[data-card]:hover {
      box-shadow: inset 0 0 0 1px var(--hairline);
    }
  }
  .tl {
    font-size: 12.5px;
    color: var(--text-sec);
  }
  .tv {
    font-size: 22px;
    font-weight: 700;
    font-family: var(--font-serif);
  }
  .td {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
