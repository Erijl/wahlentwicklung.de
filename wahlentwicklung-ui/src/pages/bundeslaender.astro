---
/** State overview: map + list. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import StateMap from '@/components/charts/StateMap.astro';
import ModuleFrame from '@/components/ModuleFrame.astro';
import PartyTag from '@/components/PartyTag.astro';
import MiniBars from '@/components/charts/MiniBars.astro';
import {
  getElectionYears,
  getStates,
  latestElectionYear,
  stateWinners,
  stateResults,
  stateVoteBase,
} from '@/lib/queries';
import { hoverCard } from '@/lib/hovercard';
import { slugify } from '@/lib/slugs';
import { fmtPct } from '@/lib/format';

const latest = latestElectionYear();
const years = getElectionYears();
const prevYear = years[years.indexOf(latest) - 1];
const winners = stateWinners(latest);
const states = getStates().map((s) => {
  const results = stateResults(latest, s.id);
  return {
    ...s,
    results,
    card: hoverCard({
      kicker: `Bundestagswahl ${latest}`,
      title: s.name,
      turnout: stateVoteBase(latest, s.id)?.turnout,
      year: latest,
      prevYear,
      results,
    }),
  };
});
const stateCards = new Map(states.map((s) => [s.name, s.card]));
---

<BaseLayout
  title="Bundesländer – Wahlergebnisse & Entwicklung"
  description={`Alle 16 Bundesländer: stärkste Partei bei der Bundestagswahl ${latest} und die Entwicklung der Ergebnisse seit 2005.`}
  path="/bundeslaender"
>
  <section class="hero">
    <p class="kicker">Übersicht</p>
    <h1>Bundesländer</h1>
    <p class="lede">
      Die 16 Länder im Vergleich — stärkste Partei {latest} auf der Karte, Entwicklung seit 2005
      auf den Detailseiten.
    </p>
  </section>

  <div class="two">
    <ModuleFrame title={`Stärkste Partei ${latest}`}>
      <StateMap winners={winners} cards={stateCards} hrefFor={(name) => `/bundesland/${slugify(name)}`} />
    </ModuleFrame>
    <ModuleFrame title="Alle Bundesländer" status="alphabetisch">
      <ul class="statelist">
        {
          [...states]
            .sort((a, b) => a.name.localeCompare(b.name, 'de'))
            .map((s) => {
              const win = winners.get(s.name);
              return (
                <li>
                  <a href={`/bundesland/${slugify(s.name)}`}>
                    <MiniBars results={s.results} card={s.card} />
                    <strong class="grow">{s.name}</strong>
                    {win && (
                      <span class="meta">
                        <PartyTag party={win.key} /> {fmtPct(win.pct)}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
        }
      </ul>
    </ModuleFrame>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 26px 0 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 32px;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .statelist {
    list-style: none;
  }
  .statelist li {
    border-bottom: 1px solid var(--hairline);
  }
  .statelist a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    color: var(--ink);
    font-size: 14.5px;
  }
  .statelist a:hover {
    text-decoration: none;
    background: var(--raised);
  }
  .grow {
    flex: 1;
    margin-left: 10px;
  }
  .meta {
    color: var(--text-sec);
    font-size: 13px;
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
  }
</style>
