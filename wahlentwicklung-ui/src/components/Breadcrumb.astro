---
/** Breadcrumb, rendered inside the chrome's contextual row (BaseLayout
 *  `crumbs` prop) — compact, current page bold. */
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Brotkrumen">
  {
    items.map((c, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {c.href ? (
          <a href={c.href}>{c.label}</a>
        ) : (
          <strong aria-current="page">{c.label}</strong>
        )}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .crumbs a {
    color: var(--text-sec);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs .sep {
    color: var(--hairline);
  }
  .crumbs strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
