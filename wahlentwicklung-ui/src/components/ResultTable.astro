---
/** Dense result table: mini result-bars + one row per area, party share
 *  columns colored by party. Collapsible (first N rows + fade + centered
 *  show-more) as progressive enhancement — without JS all rows show.
 *  Rows carry data-search so a SearchFilter island can target the table. */
import PartyTag from '@/components/PartyTag.astro';
import MiniBars from '@/components/charts/MiniBars.astro';
import { fmtPct } from '@/lib/format';
import { hoverCard } from '@/lib/hovercard';
import { CHART_ORDER, textColorVar, type PartyKey } from '@/lib/parties';
import type { ConstituencyTableRow } from '@/lib/queries';
import { constituencySlug } from '@/lib/slugs';

interface Props {
  rows: ConstituencyTableRow[];
  columns?: PartyKey[];
  linkYear?: number;
  /** Rows shown before the fade + "show more" (0 = never collapse). */
  collapsedRows?: number;
  /** id so search islands can target this table's rows. */
  listId?: string;
  /** Hover-card context: previous election year (ghost-bar legend). */
  cardPrevYear?: number;
  /** Hover-card chart label, e.g. "Erststimmen" (default Zweitstimmen). */
  cardLabel?: string;
}

const {
  rows,
  columns = CHART_ORDER.filter((k) => !['FW', 'SSW', 'Übrige'].includes(k)),
  linkYear,
  collapsedRows = 10,
  listId,
  cardPrevYear,
  cardLabel,
} = Astro.props;

const cardFor = (row: ConstituencyTableRow) =>
  linkYear
    ? hoverCard({
        kicker: `${row.stateName} · Wahlkreis ${row.number}`,
        title: row.name,
        turnout: row.turnout,
        year: linkYear,
        prevYear: cardPrevYear,
        label: cardLabel,
        results: row.results,
      })
    : undefined;
const pctOf = (row: ConstituencyTableRow, k: PartyKey) =>
  row.results.find((r) => r.key === k)?.pct ?? 0;
const collapsible = collapsedRows > 0 && rows.length > collapsedRows + 4;
---

<div class="rt" data-collapsed-rows={collapsible ? collapsedRows : undefined}>
  <div class="tblwrap">
    <table>
      <thead>
        <tr>
          <th class="wk" aria-sort="none">
            <button type="button" class="ths" data-sk="name" title="Nach Wahlkreis sortieren">Wahlkreis</button>
          </th>
          <th aria-sort="descending">
            <button type="button" class="ths" data-sk="num" title="Nach Beteiligung sortieren">Beteiligung</button>
          </th>
          {
            columns.map((k) => (
              <th aria-sort="none">
                <button type="button" class="ths" data-sk="num" title={`Nach ${k} sortieren`}>
                  <PartyTag party={k} />
                </button>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody id={listId}>
        {
          rows.map((row) => (
            <tr data-search={`${row.number} ${row.name} ${row.stateName}`}>
              <td class="wk">
                <MiniBars results={row.results} parties={columns} card={cardFor(row)} />
                <span class="wk-name">
                  <a
                    href={
                      linkYear
                        ? `/wahl/${linkYear}/wahlkreis/${constituencySlug(row.number, row.name)}`
                        : `/wahlkreis/${constituencySlug(row.number, row.name)}`
                    }
                  >
                    {row.name}
                  </a>
                  <span>{row.stateName}</span>
                </span>
              </td>
              <td>{fmtPct(row.turnout).replace(' %', '')}</td>
              {columns.map((k) => (
                <td style={`color:${textColorVar(k)}`}>{fmtPct(pctOf(row, k)).replace(' %', '')}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {
    collapsible && (
      <div class="rt-more" hidden>
        <button type="button" class="rt-more-btn" data-more-label={`Alle ${rows.length} anzeigen ↓`} data-less-label="Weniger anzeigen ↑">
          Alle {rows.length} anzeigen ↓
        </button>
      </div>
    )
  }
</div>

<script>
  // sortable headers: name column alphabetically (asc first), numeric
  // columns by value (desc first); repeat click inverts. Re-applies the
  // collapse window to the new order; an active search is unaffected
  // (collapse is suspended while searching).
  document.querySelectorAll<HTMLTableElement>('.rt table').forEach((table) => {
    const body = table.tBodies[0];
    const rt = table.closest<HTMLElement>('.rt')!;
    const ths = [...table.tHead!.rows[0].cells];
    ths.forEach((th, ci) => {
      const btn = th.querySelector<HTMLButtonElement>('.ths');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const kind = btn.dataset.sk;
        const cur = th.getAttribute('aria-sort');
        const asc = cur === 'ascending' ? false : cur === 'descending' ? true : kind === 'name';
        const rows = [...body.rows];
        const dir = asc ? 1 : -1;
        if (kind === 'name') {
          const val = (tr: HTMLTableRowElement) =>
            tr.cells[ci].querySelector('a')?.textContent?.trim() ?? '';
          rows.sort((a, b) => dir * val(a).localeCompare(val(b), 'de'));
        } else {
          const val = (tr: HTMLTableRowElement) =>
            parseFloat((tr.cells[ci].textContent ?? '').trim().replace(',', '.')) || 0;
          rows.sort((a, b) => dir * (val(a) - val(b)));
        }
        rows.forEach((r) => body.appendChild(r));
        ths.forEach((t) => t.setAttribute('aria-sort', 'none'));
        th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
        const n = Number(rt.dataset.collapsedRows);
        if (n && rt.classList.contains('rt-collapsed')) {
          rows.forEach((r, i) => r.classList.toggle('rt-hidden', i >= n));
        }
      });
    });
  });

  // collapse enhancement: hide rows past the threshold, fade + toggle
  document.querySelectorAll<HTMLElement>('.rt[data-collapsed-rows]').forEach((rt) => {
    const n = Number(rt.dataset.collapsedRows);
    const body = rt.querySelector('tbody');
    const more = rt.querySelector<HTMLElement>('.rt-more');
    const btn = rt.querySelector<HTMLButtonElement>('.rt-more-btn');
    if (!body || !more || !btn) return;
    let collapsed = true;
    const apply = () => {
      [...body.rows].forEach((tr, i) => {
        tr.classList.toggle('rt-hidden', collapsed && i >= n);
      });
      rt.classList.toggle('rt-collapsed', collapsed);
      btn.textContent = collapsed ? btn.dataset.moreLabel! : btn.dataset.lessLabel!;
    };
    more.hidden = false;
    apply();
    btn.addEventListener('click', () => {
      collapsed = !collapsed;
      apply();
      if (collapsed) rt.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
    // an active search must see all rows: suspend the collapse while querying.
    // The event fires on the search island's target container, which wraps
    // this table — listen at document level and match by containment.
    let preSearch = collapsed;
    let searching = false;
    document.addEventListener('searchfilter', (e) => {
      const container = e.target as Element;
      if (!container.contains(rt)) return;
      const q = (e as CustomEvent).detail?.query ?? '';
      if (q !== '' && !searching) {
        searching = true;
        preSearch = collapsed;
        collapsed = false;
        more.hidden = true;
        apply();
      } else if (q === '' && searching) {
        searching = false;
        collapsed = preSearch;
        more.hidden = false;
        apply();
      }
    });
  });
</script>

<style>
  .rt {
    position: relative;
  }
  .tblwrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-variant-numeric: tabular-nums;
  }
  th {
    font-size: 12px;
    color: var(--text-sec);
    text-align: right;
    font-weight: 600;
    padding: 8px 10px;
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
  }
  th.wk,
  td.wk {
    text-align: left;
    padding-left: 0;
  }
  /* sortable headers: the button inherits the th look; the sorted column
     shows its direction, unsorted columns hint ↕ on hover */
  .ths {
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .ths::after {
    font-size: 8px;
    line-height: 1;
    color: var(--text-muted);
    content: '';
    width: 8px;
  }
  th:hover .ths::after {
    content: '↕';
    font-size: 10px;
  }
  th[aria-sort='descending'] .ths::after,
  th:hover[aria-sort='descending'] .ths::after {
    content: '▼';
    font-size: 8px;
    color: var(--ink);
  }
  th[aria-sort='ascending'] .ths::after,
  th:hover[aria-sort='ascending'] .ths::after {
    content: '▲';
    font-size: 8px;
    color: var(--ink);
  }
  td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--hairline);
    text-align: right;
    font-size: 13.5px;
    font-weight: 600;
  }
  td.wk {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 400;
  }
  .wk-name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .wk-name a {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wk-name > span {
    font-size: 11.5px;
    color: var(--text-muted);
  }
  tbody tr:hover td {
    background: var(--raised);
  }
  :global(.rt-hidden) {
    display: none;
  }
  .rt-more {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 14px 0 4px;
  }
  .rt-collapsed .rt-more::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -56px;
    height: 56px;
    background: linear-gradient(to bottom, transparent, var(--surface));
    pointer-events: none;
  }
  .rt-more-btn {
    border: 1px solid var(--hairline);
    background: var(--raised);
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.08);
  }
  .rt-more-btn:hover {
    border-color: var(--accent);
  }
</style>
