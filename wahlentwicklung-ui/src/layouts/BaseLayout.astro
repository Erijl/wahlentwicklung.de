---
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/600.css';
import '@fontsource/fira-sans/700.css';
import '@fontsource/fira-sans-condensed/700.css';
import '@fontsource/noto-serif/400.css';
import '@fontsource/noto-serif/700.css';
import '@/styles/global.css';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SearchPalette from '@/components/SearchPalette.astro';
import HoverCard from '@/components/HoverCard.astro';
import YearSwitcher from '@/components/YearSwitcher.astro';

interface Props {
  /** Page title without the site suffix. */
  title: string;
  description: string;
  /** Canonical path, e.g. "/wahl/2025". */
  path: string;
  /** Breadcrumb for the contextual chrome row (nav concept C). */
  crumbs?: { label: string; href?: string }[];
  /** Year pills in the chrome: links to this page's siblings in other years. */
  yearNav?: {
    years: number[];
    current?: number;
    /** Years with comparable data (default: all); others render disabled. */
    available?: number[];
    hrefFor: (year: number) => string;
  };
  /** Right-aligned section tabs (anchor links, scroll-spy highlights). */
  tabs?: { label: string; href: string }[];
}

const { title, description, path, crumbs, yearNav, tabs } = Astro.props;
const canonical = new URL(path, Astro.site);
const fullTitle = `${title} | Wahlentwicklung.de`;

const nav = [
  { href: '/wahlen', label: 'Wahlen' },
  { href: '/parteien', label: 'Parteien' },
  { href: '/bundeslaender', label: 'Bundesländer' },
  { href: '/wahlkreise', label: 'Wahlkreise' },
];
const current = Astro.url.pathname;
const hasContextRow = Boolean(crumbs || yearNav || tabs);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* theme before paint (no FOUC): stored preference wins, else system */}
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    {/* chrome: nav concept C (double-decker) with B's search — see
        design/shell-and-hover-concept.md */}
    <header class="chrome">
      <div class="row1">
        <div class="r1-inner">
          <a class="brand" href="/">
            Wahlentwicklung<span class="tld">.de</span>
          </a>
          <nav class="primary" aria-label="Hauptnavigation">
            {
              nav.map((n) => (
                <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>
                  {n.label}
                </a>
              ))
            }
          </nav>
          <div class="r1-right">
            <button
              type="button"
              class="searchbtn"
              id="palette-open"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <svg viewBox="0 0 16 16" aria-hidden="true"
                ><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"
                ></circle><path
                  d="m10.5 10.5 3.5 3.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"></path></svg
              >
              <span class="sb-hint">Suchen …</span>
              <kbd>Strg K</kbd>
            </button>
            <button
              id="theme-toggle"
              type="button"
              class="theme-toggle"
              aria-pressed="false"
              title="Helles/dunkles Design umschalten"
            >
              <span class="tt-ico" aria-hidden="true">☾</span><span class="tt-label">Dunkel</span>
            </button>
          </div>
        </div>
        <div class="tric" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>

      {
        hasContextRow && (
          <div class="row2">
            <div class="r2-inner">
              {crumbs && <Breadcrumb items={crumbs} />}
              {yearNav && (
                <div class="years">
                  <YearSwitcher
                    years={yearNav.years}
                    current={yearNav.current}
                    available={yearNav.available}
                    hrefFor={yearNav.hrefFor}
                  />
                </div>
              )}
              {tabs && (
                <nav class="ctx-tabs" aria-label="Abschnitte">
                  {tabs.map((t) => (
                    <a href={t.href}>{t.label}</a>
                  ))}
                </nav>
              )}
            </div>
          </div>
        )
      }
    </header>

    <SearchPalette />

    <main class="site-main">
      <slot />
    </main>

    {/* hover layers: data-tip = plain text tooltip, data-card = rich result
        card. Pages stay fully static — this is progressive enhancement. */}
    <div class="tip" id="global-tip" role="tooltip" hidden></div>
    <HoverCard />
    <script>
      const tip = document.getElementById('global-tip')!;
      let current: Element | null = null;
      function move(e: PointerEvent) {
        const pad = 12;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + pad;
        let y = e.clientY + pad;
        if (x + r.width > innerWidth - 4) x = e.clientX - r.width - pad;
        if (y + r.height > innerHeight - 4) y = e.clientY - r.height - pad;
        tip.style.transform = `translate(${x}px, ${y}px)`;
      }
      document.addEventListener('pointerover', (e) => {
        const el = (e.target as Element).closest('[data-tip]');
        if (!el || el === current) return;
        current = el;
        tip.textContent = el.getAttribute('data-tip');
        tip.hidden = false;
        move(e as PointerEvent);
      });
      document.addEventListener('pointermove', (e) => {
        if (current) move(e as PointerEvent);
      });
      document.addEventListener('pointerout', (e) => {
        if (current && !current.contains((e as PointerEvent).relatedTarget as Node)) {
          current = null;
          tip.hidden = true;
        }
      });
    </script>

    <footer class="site-foot">
      <p>
        Datengrundlage: Bundeswahlleiterin, amtliche Endergebnisse 1949–2025 ·
        <a
          href="https://www.bundeswahlleiterin.de/bundestagswahlen.html"
          rel="noopener">Datensatz ↗</a
        > · <a href="/wahlen">Alle Wahlen</a> · <a href="/impressum">Impressum</a>
      </p>
    </footer>

    <script>
      // theme toggle: flips data-theme, persists, repaints icon/label
      const btn = document.getElementById('theme-toggle')!;
      const paint = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        btn.querySelector('.tt-ico')!.textContent = dark ? '☀' : '☾';
        btn.querySelector('.tt-label')!.textContent = dark ? 'Hell' : 'Dunkel';
        btn.setAttribute('aria-pressed', String(dark));
      };
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme === 'dark';
        if (dark) delete root.dataset.theme;
        else root.dataset.theme = 'dark';
        localStorage.setItem('theme', dark ? 'light' : 'dark');
        paint();
      });
      paint();

      // scroll-spy for the contextual section tabs (anchor links)
      const tabLinks = [...document.querySelectorAll<HTMLAnchorElement>('.ctx-tabs a[href^="#"]')];
      if (tabLinks.length) {
        const sections = tabLinks
          .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
          .filter((s): s is HTMLElement => s !== null);
        const update = () => {
          let cur: HTMLElement | null = null;
          for (const s of sections) {
            if (s.getBoundingClientRect().top <= 140) cur = s;
          }
          tabLinks.forEach((a) => {
            const on = cur !== null && a.hash === `#${cur.id}`;
            if (on) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        };
        addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
  </body>
</html>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 80;
  }
  .row1 {
    background: var(--raised);
  }
  .r1-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 10px 28px;
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .brand {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.01em;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .tld {
    color: var(--text-muted);
    font-weight: 400;
  }
  .primary {
    display: flex;
    gap: 20px;
    font-size: 14.5px;
    flex-wrap: wrap;
  }
  .primary a {
    color: var(--ink);
  }
  .primary a[aria-current='page'] {
    font-weight: 700;
    color: var(--accent);
  }
  .r1-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .searchbtn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-muted);
    font: inherit;
    font-size: 13.5px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .searchbtn:hover {
    color: var(--text-sec);
    border-color: var(--text-muted);
  }
  .searchbtn svg {
    width: 14px;
    height: 14px;
    flex: none;
  }
  .searchbtn kbd {
    font-family: inherit;
    font-size: 11px;
    color: var(--text-sec);
    border: 1px solid var(--hairline);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 5px;
    background: var(--raised);
    white-space: nowrap;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-sec);
    font: inherit;
    font-size: 12.5px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
  .tric {
    display: flex;
    height: 3px;
  }
  .tric i {
    flex: 1;
  }
  .tric i:nth-child(1) {
    background: var(--tric-schwarz);
  }
  .tric i:nth-child(2) {
    background: var(--tric-rot);
  }
  .tric i:nth-child(3) {
    background: var(--tric-gold);
  }

  /* contextual second row: breadcrumb + year pills + section tabs */
  .row2 {
    background: var(--raised);
    border-bottom: 1px solid var(--hairline);
  }
  .r2-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 8px 28px 0;
    display: flex;
    align-items: center;
    gap: 10px 22px;
    flex-wrap: wrap;
  }
  .r2-inner > :global(.crumbs) {
    padding-bottom: 8px;
  }
  .years {
    display: flex;
    padding-bottom: 8px;
  }
  .ctx-tabs {
    display: flex;
    gap: 2px;
    margin-left: auto;
    align-self: stretch;
  }
  .ctx-tabs a {
    font-size: 13.5px;
    color: var(--text-sec);
    padding: 6px 13px 9px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .ctx-tabs a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .ctx-tabs a[aria-current='true'] {
    color: var(--accent);
    font-weight: 700;
    border-bottom-color: var(--accent);
  }

  @media (max-width: 780px) {
    /* the double-decker would eat too much of a phone screen when sticky */
    .chrome {
      position: static;
    }
    .r1-inner {
      flex-wrap: wrap;
      gap: 8px 18px;
      padding-inline: 16px;
    }
    .searchbtn .sb-hint,
    .searchbtn kbd {
      display: none;
    }
    .theme-toggle .tt-label {
      display: none;
    }
    .r2-inner {
      padding-inline: 16px;
    }
    .ctx-tabs {
      display: none;
    }
  }

  .site-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px 40px;
  }
  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 250;
    pointer-events: none;
    background: var(--ink);
    color: var(--surface);
    font-size: 12.5px;
    line-height: 1.4;
    padding: 6px 9px;
    border-radius: 4px;
    max-width: 280px;
    white-space: pre-line;
  }
  .site-foot {
    border-top: 1px solid var(--hairline);
    color: var(--text-muted);
    font-size: 12.5px;
  }
  .site-foot p {
    max-width: 1120px;
    margin: 0 auto;
    padding: 20px 28px 40px;
  }
</style>
